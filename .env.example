# --- Database (required in production): PostgreSQL ---
# Vercel → Project → Storage → "Neon Postgres" sets DATABASE_URL / POSTGRES_URL automatically.
DATABASE_URL=
# (alternative) Upstash Redis: KV_REST_API_URL= / KV_REST_API_TOKEN=

# --- Admin ---
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Owner key for the one-time first-admin page /admin/setup (12+ chars). Required in production.
ADMIN_SETUP_KEY=
# Optional alternative: seed the first admin from env instead of /admin/setup.
# NEVER put real values in this file (it is public). Put them in .env.local or in Vercel → Environment Variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- Password reset by email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=VisaReview <no-reply@yourdomain.com>

# --- Password reset by SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000

# --- Optional AI (Claude) for deeper refusal analysis, document review and letter polishing ---
ANTHROPIC_API_KEY=
