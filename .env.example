# --- Permanent storage (required in production) ---
# Vercel → Project → Storage → "Upstash for Redis" sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (or) UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=

# --- Admin ---
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Optional: seed the first admin instead of using the first-run setup screen
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
# Optional: require this key on the first-run setup screen
ADMIN_SETUP_KEY=

# --- Password reset by email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=VisaReview <no-reply@yourdomain.com>

# --- Password reset by SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000

# --- Optional AI (Claude) for deeper refusal analysis, document review and letter polishing ---
ANTHROPIC_API_KEY=
